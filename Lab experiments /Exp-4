
def plural_fsm(noun):
    if noun.endswith(("s", "sh", "ch", "x", "z")):
        return noun + "es"
    elif noun.endswith("y") and noun[-2] not in "aeiou":
        return noun[:-1] + "ies"
    else:
        return noun + "s"


words = ["book", "box", "class", "baby", "cat"]

print("Singular\tPlural")
for word in words:
    print(word, "\t\t", plural_fsm(word))

