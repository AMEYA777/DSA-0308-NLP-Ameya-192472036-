import nltk

grammar = nltk.PCFG.fromstring("""
S -> NP VP [1.0]
NP -> Det N [0.7] | N [0.3]
VP -> V NP [0.8] | V [0.2]
Det -> 'the' [1.0]
N -> 'student' [0.5] | 'book' [0.5]
V -> 'reads' [1.0]
""")

parser = nltk.ViterbiParser(grammar)

sentence = "the student reads book".split()

print("INPUT:", " ".join(sentence))
print("\nPROBABILISTIC PARSE RESULT:")

for tree in parser.parse(sentence):
    print(tree)
    print("Probability:", tree.prob())
