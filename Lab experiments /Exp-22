import spacy

nlp = spacy.load("en_core_web_sm")

text = """
Ravi is a student.
He studies Python programming.
Priya is his friend.
She likes computer science.
"""

doc = nlp(text)

print("REFERENCE RESOLUTION")
print("--------------------")

previous_person = ""

for token in doc:

    if token.pos_ == "PROPN":
        previous_person = token.text

    elif token.text.lower() in ["he", "she"]:
        print(token.text, "refers to", previous_person)

print("\nReference resolution completed.")
