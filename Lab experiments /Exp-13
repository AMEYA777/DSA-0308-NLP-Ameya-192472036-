import nltk

grammar = nltk.CFG.fromstring("""
S -> NP VP
NP -> Det N
VP -> V NP
Det -> 'the' | 'a'
N -> 'girl' | 'flower'
V -> 'likes' | 'sees'
""")

parser = nltk.ChartParser(grammar)

sentence = "the girl likes a flower".split()

print("SENTENCE:", " ".join(sentence))
print("\nGENERATED PARSE TREE:")

for tree in parser.parse(sentence):
    print(tree)
    tree.pretty_print()
