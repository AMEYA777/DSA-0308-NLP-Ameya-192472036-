from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

sentences = [
    "Python is a programming language.",
    "Python is easy to learn and use.",
    "Python is used in machine learning.",
    "The weather is very cold today."
]

vectorizer = TfidfVectorizer()

matrix = vectorizer.fit_transform(sentences)

print("TEXT COHERENCE EVALUATION\n")

for i in range(len(sentences)-1):

    score = cosine_similarity(
        matrix[i], matrix[i+1]
    )[0][0]

    print("Sentence 1:", sentences[i])
    print("Sentence 2:", sentences[i+1])
    print("Coherence Score:", round(score, 3))

    if score > 0.1:
        print("Result: Related Sentences")
    else:
        print("Result: Less Related Sentences")

    print()
